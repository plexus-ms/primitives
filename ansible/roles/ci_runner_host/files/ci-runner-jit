#!/bin/bash
# Mints the just-in-time runner config of one container slot and writes it,
# root-only, where the slot's container reads it (ExecStartPre of
# ci-runner@.service). Managed by Ansible (ci_runner_host). The config is
# single-use: the runner registers with it, takes one job, and the forge
# removes the registration when the job ends. Hand-runnable as root:
#
#   ci-runner-jit small-1 && cat /run/ci-runner/small-1.env
#
# From /etc/ci-runner/runner.env: SCOPE (repo | org), REPO (owner/name),
# ORG, GROUP (the runner group's name, scope org), HOST (the name prefix),
# EXTRA_LABELS (comma-separated). From /etc/ci-runner/app.env: APP_CLIENT_ID;
# the App's private key is /etc/ci-runner/app.pem.
set -euo pipefail
instance=${1:?the slot, e.g. small-1}
size=${instance%-*}
# shellcheck source=/dev/null
. /etc/ci-runner/runner.env
# shellcheck source=/dev/null
. /etc/ci-runner/app.env
name="$HOST-$instance"
out=/run/ci-runner/$instance.env

# A failure waits before it fails, so that a forge outage costs one attempt
# per slot every half minute rather than every restart interval.
trap 'echo "ci-runner-jit: minting the config of $name failed" >&2; sleep 30' ERR

api() {
  curl -fsS --retry 3 --max-time 30 \
    -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28' "$@"
}
b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# The App's JWT, issued by its client id, valid for nine minutes.
now=$(date +%s)
unsigned="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url).$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$APP_CLIENT_ID" | b64url)"
jwt="$unsigned.$(printf '%s' "$unsigned" | openssl dgst -sha256 -sign /etc/ci-runner/app.pem -binary | b64url)"

# An installation token narrowed to what registering a runner takes.
case "$SCOPE" in
  repo)
    base=repos/$REPO
    installation=repos/$REPO/installation
    grant=$(jq -nc --arg r "${REPO#*/}" '{repositories: [$r], permissions: {administration: "write"}}')
    ;;
  org)
    base=orgs/$ORG
    installation=orgs/$ORG/installation
    grant='{"permissions":{"organization_self_hosted_runners":"write"}}'
    ;;
  *)
    echo "SCOPE is repo or org, not '$SCOPE'" >&2
    exit 1
    ;;
esac
id=$(api -H "Authorization: Bearer $jwt" "https://api.github.com/$installation" | jq -er .id)
token=$(api -X POST -H "Authorization: Bearer $jwt" -d "$grant" \
  "https://api.github.com/app/installations/$id/access_tokens" | jq -er .token)
auth="Authorization: Bearer $token"

# A repository's runners are always in its organisation's default group.
group_id=1
if [ "$SCOPE" = org ]; then
  group_id=$(api -H "$auth" "https://api.github.com/orgs/$ORG/actions/runner-groups?per_page=100" |
    jq -er --arg g "$GROUP" '.runner_groups[] | select(.name == $g) | .id')
fi

# A registration under this slot's name is its previous container's, which
# never took a job (a stop, a reboot); the name has to be free again.
api -H "$auth" "https://api.github.com/$base/actions/runners?per_page=100" |
  jq -r --arg n "$name" '.runners[] | select(.name == $n) | .id' |
  while read -r old; do
    api -X DELETE -H "$auth" "https://api.github.com/$base/actions/runners/$old"
    echo "removed the stale registration $old of $name"
  done

labels=$(jq -nc --arg size "ci-$size" --arg extra "${EXTRA_LABELS:-}" \
  '[$size] + ($extra | split(",") | map(select(. != "")))')
body=$(jq -nc --arg n "$name" --argjson g "$group_id" --argjson l "$labels" \
  '{name: $n, runner_group_id: $g, labels: $l, work_folder: "_work"}')
jit=$(api -X POST -H "$auth" -d "$body" \
  "https://api.github.com/$base/actions/runners/generate-jitconfig" | jq -er .encoded_jit_config)

# The runner reads the config from ACTIONS_RUNNER_INPUT_JITCONFIG and clears
# the variable before any job step runs, so it is never on a command line.
umask 077
mkdir -p /run/ci-runner
printf 'ACTIONS_RUNNER_INPUT_JITCONFIG=%s\n' "$jit" >"$out"
echo "$name: registered on $base with $labels"
