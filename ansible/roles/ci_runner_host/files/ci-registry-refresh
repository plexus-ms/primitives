#!/bin/sh
# Keeps the registry pair of a CI runner host on this month's buckets:
# the CNCF distribution registry on 127.0.0.1:5000 against
# <owner>-ci-registry-<this month>, read-write, and on :5001 against the
# previous month's, read-only — the pair `plx-ci registry` starts for itself
# where none answers (§ 8 PLX-Delivery). Creates this month's bucket when it
# is missing; a container already on the right bucket and image is left
# running. Managed by Ansible (ci_runner_host), run by the hourly
# housekeeping. Hand-runnable as root: ci-registry-refresh; with
# RECREATE=True both containers are created anew (a new key).
#
# From /etc/ci-registry/registry.env (the registry's own variables, which
# the containers read as their env file): the storage endpoint, region and
# key; from /etc/ci-registry/pair.env: OWNER and IMAGE.
set -eu
env_file=/etc/ci-registry/registry.env
# shellcheck source=/dev/null
. /etc/ci-registry/pair.env
value() { sed -n "s/^$1=//p" "$env_file"; }
endpoint=$(value REGISTRY_STORAGE_S3_REGIONENDPOINT)
region=$(value REGISTRY_STORAGE_S3_REGION)

month() { date -u -d "$(date -u +%Y-%m-15) $1 month" +%Y-%m; }
current="$OWNER-ci-registry-$(month 0)"
previous="$OWNER-ci-registry-$(month -1)"

# The bucket, through the storage's S3 API, signed with the key.
s3() {
  printf 'user = "%s:%s"\n' "$(value REGISTRY_STORAGE_S3_ACCESSKEY)" "$(value REGISTRY_STORAGE_S3_SECRETKEY)" |
    curl -sS --max-time 30 -o /dev/null -w '%{http_code}' --config - --aws-sigv4 "aws:amz:$region:s3" "$@"
}
status=$(s3 --head "$endpoint/$current")
case "$status" in
  200) ;;
  404)
    status=$(s3 -X PUT "$endpoint/$current")
    [ "$status" = 200 ] || { echo "creating the bucket $current answered $status" >&2; exit 1; }
    echo "created the bucket $current"
    ;;
  *) echo "looking up the bucket $current answered $status" >&2; exit 1 ;;
esac

# One registry container on one bucket. In a strategy's first month the
# previous month's bucket does not exist and that registry answers 503, which
# the jobs read as no previous cache; the month change moves it to a bucket
# that does.
ensure() {
  name=$1 port=$2 bucket=$3 mode=$4
  have=$(docker inspect --format '{{ index .Config.Labels "plexus.ci.bucket" }} {{ .Config.Image }} {{ .State.Running }}' "$name" 2>/dev/null || true)
  [ "${RECREATE:-}" != True ] && [ "$have" = "$bucket $IMAGE true" ] && return 0
  docker rm --force "$name" >/dev/null 2>&1 || true
  if [ "$mode" = rw ]; then
    extra='--restart unless-stopped -e REGISTRY_STORAGE_DELETE_ENABLED=true'
  else
    # The read-only flag as one YAML value: registry:2 panics on it as
    # …_READONLY_ENABLED=true (the map it builds from that has the wrong type).
    extra='--restart on-failure:3 -e REGISTRY_STORAGE_MAINTENANCE_READONLY={"enabled":true}'
  fi
  # shellcheck disable=SC2086
  docker run --detach --name "$name" $extra \
    --publish "127.0.0.1:$port:5000" \
    --label "plexus.ci.bucket=$bucket" \
    --env-file "$env_file" \
    -e "REGISTRY_STORAGE_S3_BUCKET=$bucket" \
    "$IMAGE" >/dev/null
  echo "$name: :$port on $bucket ($mode)"
}
ensure ci-registry 5000 "$current" rw
ensure ci-registry-previous 5001 "$previous" ro

for _ in $(seq 1 30); do
  curl -fsS --max-time 3 -o /dev/null http://127.0.0.1:5000/v2/ && exit 0
  sleep 1
done
echo "the registry on :5000 does not answer" >&2
exit 1
