# Managed by Ansible (plexus.platform) — routes for tenant "{{ plexus_tenant }}".
# Imported by /etc/caddy/Caddyfile; co-hosted tenants own disjoint files.
# Caddy obtains + renews Let's Encrypt certs automatically for each host
# below (needs DNS → this host and ports 80/443 open).
# One site per host: apps sharing a host each take a path prefix (`path:` in
# the inventory record); an app without one serves the host's root. The
# prefix is stripped before the request reaches the app, so the app serves
# from its own root and learns its public URL from its environment.
#
# /healthz is readiness for the deploy verb, probed on the host; publicly it
# would be a dependency-status oracle, so the proxy refuses it (§ 7.1 PLX).
# A third-party app declares another path via its plexus.healthz label
# (§ 5.5 PLX) and mirrors it as `healthz:` in its inventory record, so the
# proxy — which has no compose file to read — fences that one too.
{% for host, apps in plexus_apps | groupby('host') %}
{{ host }} {
	encode zstd gzip
{% for app in apps %}
{% if app.path is defined %}
	# {{ app.name }}, under {{ app.path }}/
	redir {{ app.path }} {{ app.path }}/
	handle_path {{ app.path }}/* {
{% else %}
	# {{ app.name }}
	handle {
{% endif %}
		respond /healthz 403
{% if app.healthz is defined and app.healthz != '/healthz' %}
		respond {{ app.healthz }} 403
{% endif %}
		reverse_proxy 127.0.0.1:{{ app.loopback_port }}
	}
{% endfor %}
{% if apps | selectattr('path', 'undefined') | list | length == 0 %}
	# No app serves this host's root.
	handle {
		respond 404
	}
{% endif %}
	# Backend unreachable (deploy rollout, crash, migration window): serve a
	# plain maintenance page instead of a bare 502. Auto-refreshes; Retry-After
	# keeps well-behaved clients polling. Tenants override the copy via
	# configure_ingress_maintenance_lang / _title / _text in their inventory.
	handle_errors {
		@backend_down expression `{err.status_code} in [502, 503, 504]`
		handle @backend_down {
			header Retry-After 120
			respond <<MAINTENANCE
				<!doctype html><html lang="{{ configure_ingress_maintenance_lang | default('en') }}"><head><meta charset="utf-8">
				<meta name="viewport" content="width=device-width, initial-scale=1">
				<meta http-equiv="refresh" content="60">
				<title>{{ configure_ingress_maintenance_title | default('Back in a minute') }}</title>
				<style>body{font-family:system-ui,sans-serif;display:grid;place-items:center;min-height:100vh;margin:0;background:#f8fafc;color:#0f172a}main{text-align:center;padding:2rem;max-width:30rem}h1{font-size:1.4rem;margin-bottom:.5rem}p{color:#475569;line-height:1.5}</style>
				</head><body><main>
				<h1>{{ configure_ingress_maintenance_title | default('Back in a minute') }}</h1>
				<p>{{ configure_ingress_maintenance_text | default('This service is briefly unavailable for maintenance. This page refreshes automatically.') }}</p>
				</main></body></html>
				MAINTENANCE 503
		}
	}
}
{% endfor %}
