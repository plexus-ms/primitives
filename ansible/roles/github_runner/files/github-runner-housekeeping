#!/bin/sh
# Nightly housekeeping for the GitHub Actions runners on this host. Managed by
# Ansible (github_runner); ROOT, CACHE_DIR, RUNNER_USER, PRUNE_DAYS,
# CONTAINER_HOURS, BUILD_CACHE_MAX and DISK_ALERT_PERCENT come from the unit's
# environment. Hand-runnable:
#   ROOT=/opt/actions-runner CACHE_DIR=/var/cache/github-runner \
#   RUNNER_USER=runner PRUNE_DAYS=7 CONTAINER_HOURS=6 BUILD_CACHE_MAX=15GB \
#   DISK_ALERT_PERCENT=85 github-runner-housekeeping
set -eu
: "${ROOT:?}" "${CACHE_DIR:?}" "${RUNNER_USER:?}" "${PRUNE_DAYS:?}" "${CONTAINER_HOURS:?}" "${BUILD_CACHE_MAX:?}" "${DISK_ALERT_PERCENT:?}"

# A busy instance has a Runner.Worker process under its directory.
busy() { pgrep -f "^$1/bin/Runner.Worker" >/dev/null; }
idle=true
for inst in "$ROOT"/*/; do
  busy "${inst%/}" && idle=false
done

# Repo working directories (_work/<repo>/<repo>) untouched for PRUNE_DAYS
# days, on instances that are idle right now. The runner's own directories
# (_work/_temp, _tool, _actions, …) are left to the runner.
for inst in "$ROOT"/*/; do
  inst=${inst%/}
  [ -d "$inst/_work" ] || continue
  if busy "$inst"; then
    echo "$inst: job running, working directories kept"
    continue
  fi
  find "$inst/_work" -mindepth 2 -maxdepth 2 -type d -not -path "$inst/_work/_*" \
    -mtime +"$PRUNE_DAYS" -print -exec rm -rf {} +
done

# Containers older than CONTAINER_HOURS, running or not, with their anonymous
# volumes. A job's containers live as long as the job; one that outlives it
# was left behind, by a test that started a development database and never
# stopped it, or by a step that ran a container without --rm.
cutoff=$(($(date +%s) - CONTAINER_HOURS * 3600))
docker ps --all --quiet --no-trunc | while read -r id; do
  info=$(docker inspect --format '{{.Created}} {{.Name}}' "$id") || continue
  created=${info%% *}
  if [ "$(date -d "$created" +%s)" -lt "$cutoff" ]; then
    docker rm --force --volumes "$id" >/dev/null
    echo "removed container ${info#* /}, created $created"
  fi
done
docker network prune --force --filter "until=${CONTAINER_HOURS}h"

# Volumes no container uses. Anonymous ones belonged to a container that is
# gone (the runner removes a job's service containers without them) and go
# always. Images and named volumes go only while no job runs: a job pulls an
# image, or its compose project creates a volume, a moment before the
# container that uses it exists. No age filter on images, because `until`
# compares when an image was built, not when it was last used; the release
# job removes the image it built, so what is here was pulled and comes back
# with the next pull.
docker volume prune --force
if $idle; then
  docker volume prune --all --force
  docker image prune --all --force
else
  echo "a job is running: images and named volumes kept"
fi

# The build cache is the layer cache of a persistent runner (the release job
# builds with the daemon's own builder, no cache export), so it is capped by
# size, least recently used first, never emptied.
docker builder prune --all --force --max-used-space "$BUILD_CACHE_MAX"

# The deploy wrapper starts an ssh-agent holding the deploy key and never
# stops it; on a persistent runner they would accumulate, key and all.
killall --older-than 1h --user "$RUNNER_USER" ssh-agent 2>/dev/null || true

used=$(df --output=pcent / | tail -1 | tr -dc '0-9')
echo "root file system ${used}% used"
if [ "$used" -gt "$DISK_ALERT_PERCENT" ]; then
  echo "above ${DISK_ALERT_PERCENT}%: look at $CACHE_DIR (the shared caches), $ROOT/*/home (each instance's own), $ROOT/*/_work and docker system df" >&2
  exit 1
fi
